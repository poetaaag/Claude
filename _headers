/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
  Permissions-Policy: accelerometer=(), camera=(), geolocation=(), gyroscope=(), magnetometer=(), microphone=(), payment=(), usb=()
  Cross-Origin-Opener-Policy: same-origin
  Cross-Origin-Resource-Policy: same-origin
  Strict-Transport-Security: max-age=31536000
  Content-Security-Policy: default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; form-action 'self'; script-src 'self'; connect-src 'self'; img-src 'self' data:; style-src 'self' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com data:; upgrade-insecure-requests

/index.html
  Cache-Control: public, max-age=0, must-revalidate

/portfolio.html
  Cache-Control: public, max-age=0, must-revalidate

/privacy.html
  Cache-Control: public, max-age=0, must-revalidate

/cookie.html
  Cache-Control: public, max-age=0, must-revalidate

/termini.html
  Cache-Control: public, max-age=0, must-revalidate

/murales*.html
  Cache-Control: public, max-age=0, must-revalidate

/cart.html
  Cache-Control: public, max-age=0, must-revalidate
  X-Robots-Tag: noindex, nofollow

/404.html
  Cache-Control: public, max-age=0, must-revalidate
  X-Robots-Tag: noindex, nofollow

/fr/*.html
  Cache-Control: public, max-age=0, must-revalidate

/fr/cart.html
  Cache-Control: public, max-age=0, must-revalidate
  X-Robots-Tag: noindex, nofollow

/en/*.html
  Cache-Control: public, max-age=0, must-revalidate

/en/cart.html
  Cache-Control: public, max-age=0, must-revalidate
  X-Robots-Tag: noindex, nofollow

/assets/*-v*.css
  Cache-Control: public, max-age=31536000, immutable

/assets/*-v*.js
  Cache-Control: public, max-age=31536000, immutable

/assets/*-v*.json
  Cache-Control: public, max-age=31536000, immutable

/assets/*.webp
  Cache-Control: public, max-age=604800, stale-while-revalidate=2592000

/assets/*.png
  Cache-Control: public, max-age=604800, stale-while-revalidate=2592000

/assets/*.jpg
  Cache-Control: public, max-age=604800, stale-while-revalidate=2592000

/assets/*.jpeg
  Cache-Control: public, max-age=604800, stale-while-revalidate=2592000

/assets/*.svg
  Cache-Control: public, max-age=604800, stale-while-revalidate=2592000

/assets/*.csv
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

/assets/*.md
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

/assets/*.txt
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

/privacy.html
  X-Robots-Tag: noindex, nofollow

/cookie.html
  X-Robots-Tag: noindex, nofollow

/termini.html
  X-Robots-Tag: noindex, nofollow

/en/privacy.html
  X-Robots-Tag: noindex, nofollow

